+"""Build fast sample assets without changing coordinates, provenance, or metrics.
+
+Usage: python split_sample.py DIRECTORY_CONTAINING_INDEX_HTML
+The full portable event is retained for direct download / backward compatibility.
+"""
+from pathlib import Path
+import json, sys
+folder = Path(sys.argv[1]) / "data"
+sample = json.loads((folder / "idai-event.json").read_text(encoding="utf-8"))
+later = {}
+for name in ("observed", "change_new", "change_persistent", "change_receded"):
+    if name in sample["layers"]:
+        later[name] = sample["layers"][name]
+        sample["layers"][name] = {"type": "FeatureCollection", "features": []}
+for name, value in (("idai-first-day-v1.json", sample), ("idai-later-layers-v1.json", later)):
+    (folder / name).write_text(json.dumps(value, separators=(",", ":"), ensure_ascii=False, allow_nan=False), encoding="utf-8")
