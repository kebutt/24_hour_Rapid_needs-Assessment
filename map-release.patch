+"""Build a static XYZ PNG portrayal and TileJSON for the published Idai observation.
+Usage: python build_observed_tiles.py <site-root> [public-base-url]
+Only the Python standard library is needed. The source geometry is never modified.
+"""
+import json, math, struct, sys, zlib
+from pathlib import Path
+
+def project(p):
+    return ((p[0]+180)/360, (1-math.asinh(math.tan(math.radians(p[1])))/math.pi)/2)
+
+def chunk(tag,data):
+    return struct.pack('!I',len(data))+tag+data+struct.pack('!I',zlib.crc32(tag+data)&0xffffffff)
+
+def png(raw):
+    return (b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',struct.pack('!IIBBBBB',256,256,8,3,0,0,0))+
+            chunk(b'PLTE',bytes([23,118,141])*5)+chunk(b'tRNS',bytes([0,64,128,191,255]))+
+            chunk(b'IDAT',zlib.compress(raw,7))+chunk(b'IEND',b''))
+
+def main(root,base):
+    event=json.loads((root/'data/idai-event.json').read_text())
+    assert event['event']['id']=='idai-2019' and event['stages']['observed']['asOf'].startswith('20 March 2019')
+    polygons=[]
+    for f in event['layers']['observed']['features']:
+        g=f['geometry']; assert g['type'] in ('Polygon','MultiPolygon')
+        for polygon in ([g['coordinates']] if g['type']=='Polygon' else g['coordinates']):
+            polygons.append([[project(point) for point in ring] for ring in polygon])
+    bounds=[34.2,-20.2,35.0,-19.2]   # fixed release identity; fail instead of cropping a changed source
+    xmin,ymin=project([bounds[0],bounds[3]]);xmax,ymax=project([bounds[2],bounds[1]])
+    assert all(xmin-1e-12<=x<=xmax+1e-12 and ymin-1e-12<=y<=ymax+1e-12 for poly in polygons for ring in poly for x,y in ring)
+    dest=root/'data/tiles/idai-flood-v1';dest.mkdir(parents=True,exist_ok=True)
+    count=0;total=0
+    for zoom in range(13):
+        n=2**zoom; x0,x1=math.floor(xmin*n),math.floor(xmax*n);y0,y1=math.floor(ymin*n),math.floor(ymax*n)
+        # Two by two supersampling, using even/odd scanline fill within each polygon.
+        width=(x1-x0+1)*512;height=(y1-y0+1)*512; pixels=[bytearray(width) for _ in range(height)]
+        for poly in polygons:
+            crosses={}
+            for ring in poly:
+                prev=ring[-1]
+                for cur in ring:
+                    ax,ay=(prev[0]*n-x0)*512,(prev[1]*n-y0)*512
+                    bx,by=(cur[0]*n-x0)*512,(cur[1]*n-y0)*512;prev=cur
+                    if ay==by: continue
+                    for y in range(max(0,math.ceil(min(ay,by)-.5)), min(height,math.ceil(max(ay,by)-.5))):
+                        crosses.setdefault(y,[]).append(ax+(y+.5-ay)*(bx-ax)/(by-ay))
+            for y,xs in crosses.items():
+                xs.sort();assert len(xs)%2==0
+                for left,right in zip(xs[::2],xs[1::2]):
+                    a=max(0,math.ceil(left-.5));b=min(width,math.ceil(right-.5))
+                    if b>a:pixels[y][a:b]=b'\x01'*(b-a)
+        for xt in range(x0,x1+1):
+            tilecol=dest/str(zoom)/str(xt);tilecol.mkdir(parents=True,exist_ok=True)
+            a=(xt-x0)*512;b=a+512
+            for yt in range(y0,y1+1):
+                lines=bytearray();start=(yt-y0)*512
+                for y in range(start,start+512,2):
+                    row=pixels[y][a:b];nxt=pixels[y+1][a:b];lines.append(0)
+                    lines.extend(i+j+k+l for i,j,k,l in zip(row[::2],row[1::2],nxt[::2],nxt[1::2]))
+                data=png(lines);(tilecol/(str(yt)+'.png')).write_bytes(data);total+=len(data);count+=1
+    spec={'tilejson':'3.0.0','name':'Idai: mapped floodwater, 20 March 2019','version':'1.0.0',
+          'description':'Transparent map portrayal of the retrospective UNOSAT observation; not first-day evidence or an analytical raster.',
+          'attribution':'<a href="https://unosat.org/products/2701">UNITAR-UNOSAT</a> / Copernicus ESA Sentinel-1 · CC BY-NC 3.0',
+          'tiles':[base.rstrip('/')+'/data/tiles/idai-flood-v1/{z}/{x}/{y}.png'],
+          'bounds':bounds,'minzoom':0,'maxzoom':12,'scheme':'xyz'}
+    (dest/'tilejson.json').write_text(json.dumps(spec,indent=2)+'\n')
+    print(f'{len(polygons)} source polygons -> {count} PNG tiles, {total:,} bytes')
+if __name__=='__main__':
+    main(Path(sys.argv[1]),sys.argv[2] if len(sys.argv)>2 else 'https://kebutt.github.io/24_hour_Rapid_needs-Assessment')
